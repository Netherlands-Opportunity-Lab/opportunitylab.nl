source "https://rubygems.org"

gem "github-pages", "~> 232", group: :jekyll_plugins
gem "jekyll-include-cache"

# Needed to run Jekyll 3 locally on Ruby 3.4+, which no longer ships these
# as default gems. GitHub Pages ignores them.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
gem "webrick"

# Windows: timezone data and file watching.
gem "tzinfo-data", platforms: [:windows, :jruby]
gem "wdm", ">= 0.1.0", platforms: [:windows]
